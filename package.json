{
  "name": "orbite-voc-audika",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.7.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "fr.audika.orbite.voc",
    "productName": "ORBITE VoC",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/orbite_backend.exe",
        "to": "backend/orbite_backend.exe"
      },
      {
        "from": "backend/modele_consolide2.xlsx",
        "to": "backend/modele_consolide2.xlsx"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "ORBITE-VoC-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}